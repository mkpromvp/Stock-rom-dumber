			node-69 = "SSPM_SWPM_CPU__PMU_TIMES\0idx_cnt,lock,idx_rechk,lock_rechk,valid,off_hint,diff_us";
			phandle = <0x1df>;
		};
	};

	trusty {
		compatible = "android,trusty-smc-v1";
		ranges;
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		tee-id = <0x00>;
		tee-name = "trusty";
		phandle = <0x1e0>;

		trusty-virtio {
			compatible = "android,trusty-virtio-v1";
			phandle = <0xd4>;
		};

		trusty-irq {
			compatible = "android,trusty-irq-v1";
			ppi-interrupt-parent = <0x01>;
			phandle = <0xd5>;
		};

		tz-system {
			compatible = "mediatek,trusty-tz";
			virtio-supply = <0xd4>;
			irq-supply = <0xd5>;
			phandle = <0xd6>;
		};

		mtee {
			compatible = "mediatek,trusty-mtee-v1";
			tz-supply = <0xd6>;
			phandle = <0x66>;
		};

		trusty-gz-log {
			compatible = "android,trusty-gz-log-v1";
		};
	};

	nebula-log {
		compatible = "android,nebula-log-v1";
		status = "disabled";
		phandle = <0x1e1>;
	};

	nebula {
		compatible = "android,nebula-smc-v1";
		ranges;
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		tee-id = <0x01>;
		tee-name = "nebula";
		phandle = <0x1e2>;

		nebula-virtio {
			compatible = "android,nebula-virtio-v1";
		};

		nebula-irq {
			compatible = "android,nebula-irq-v1";
			ppi-interrupt-parent = <0x01>;
		};

		nebula-gz-log {
			compatible = "android,nebula-gz-log-v1";
		};
	};

	hypervisor {
		compatible = "mediatek,geniezone-hyp\0mediatek,geniezone";
		status = "okay";
		phandle = <0x1e3>;
	};

