#! /system/bin/sh
cmd=$1
#echo "cmd:$cmd cmd1:$cmd1 cmd2:$cmd2 cmd3:$cmd3"
#echo "cmd:$@"
if [ "$cmd" = "nfcdieid" ]; then
	val=`tdt -n dev/tms_nfc -b -f --chip_info=die_id | grep "Die ID"`
	if [ -n "$val" ];then
        echo $val
    else
        echo "fail"
    fi
	exit 0
elif [ "$cmd" = "nfccplc" ]; then
	val=`tdt -n dev/tms_nfc -b -f --chip_info=ese | grep "CPLC: "`
	if [ -n "$val" ];then
        echo $val
    else
        echo "fail"
    fi
	exit 0
else
	echo `factoryAta mifunctiontest $1 $2 $3 $4 $5`
fi
